# CareerAI Environment Configuration Example

# Backend Port (Default: 5000)
PORT=5000
FLASK_ENV=production

# Frontend API Target (Vite)
VITE_API_URL=http://127.0.0.1:5000

# Optional: AI Service Keys (If not configured, CareerAI automatically runs rule-based offline NLP)
# OPENAI_API_KEY=your_openai_api_key_here
# GEMINI_API_KEY=your_gemini_api_key_here
